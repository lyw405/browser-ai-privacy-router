{
  "name": "browser-ai-privacy-router",
  "version": "0.1.0",
  "description": "Browser-side AI privacy routing middleware SDK. Classify, mask, route and audit user data before it reaches cloud AI.",
  "keywords": [
    "privacy",
    "pii",
    "ai",
    "router",
    "masking",
    "compliance",
    "audit",
    "browser",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyw405/browser-ai-privacy-router.git"
  },
  "bugs": {
    "url": "https://github.com/lyw405/browser-ai-privacy-router/issues"
  },
  "homepage": "https://github.com/lyw405/browser-ai-privacy-router#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
